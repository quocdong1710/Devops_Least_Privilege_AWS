{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AIDevOpsAgentReadOnlyScoped",
      "Effect": "Allow",
      "Action": [
        "aidevops:DescribePrivateConnection",
        "aidevops:DescribeServices",
        "aidevops:Get*",
        "aidevops:List*",
        "aidevops:SearchServiceAccessibleResource"
      ],
      "Resource": [
        "arn:aws:aidevops:*:${aws:PrincipalAccount}:agentspace/*",
        "arn:aws:aidevops:*:${aws:PrincipalAccount}:privateconnection/*"
      ]
    },
    {
      "Sid": "AuditTrailAndComplianceVerificationScoped",
      "Effect": "Allow",
      "Action": [
        "cloudtrail:LookupEvents",
        "cloudtrail:DescribeTrails",
        "cloudtrail:GetTrailStatus",
        "config:DescribeConfigRules",
        "config:GetComplianceDetailsByConfigRule",
        "config:GetComplianceDetailsByResource"
      ],
      "Resource": [
        "arn:aws:cloudtrail:*:${aws:PrincipalAccount}:trail/*",
        "arn:aws:config:*:${aws:PrincipalAccount}:config-rule/*"
      ]
    },
    {
      "Sid": "AccessAnalyzerAndPolicyOptimizationAuditScoped",
      "Effect": "Allow",
      "Action": [
        "access-analyzer:ListFindings",
        "access-analyzer:GetFinding",
        "access-analyzer:ListAnalyzers",
        "iam:GenerateServiceLastAccessedDetails",
        "iam:GetServiceLastAccessedDetails",
        "iam:ListPolicies",
        "iam:GetPolicyVersion"
      ],
      "Resource": [
        "arn:aws:access-analyzer:*:${aws:PrincipalAccount}:analyzer/*",
        "arn:aws:iam::${aws:PrincipalAccount}:policy/*",
        "arn:aws:iam::${aws:PrincipalAccount}:role/*"
      ]
    },
    {
      "Sid": "ExplicitDenyChatAndMutationActions",
      "Effect": "Deny",
      "Action": [
        "aidevops:CreateChat",
        "aidevops:SendMessage",
        "aidevops:Create*",
        "aidevops:Update*",
        "aidevops:Delete*",
        "cloudtrail:StopLogging",
        "cloudtrail:DeleteTrail",
        "iam:CreatePolicy",
        "iam:AttachRolePolicy",
        "iam:AttachUserPolicy"
      ],
      "Resource": "*"
    }
  ]
}
