{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowOperatorScopedToAgentSpace",
      "Effect": "Allow",
      "Action": [
        "aidevops:CreateChat",
        "aidevops:SendMessage",
        "aidevops:ListChats",
        "aidevops:ListExecutions",
        "aidevops:ListJournalRecords",
        "aidevops:DiscoverTopology",
        "aidevops:ListRecommendations",
        "aidevops:GetRecommendation",
        "aidevops:CreateBacklogTask",
        "aidevops:UpdateBacklogTask",
        "aidevops:GetAgentSpace",
        "aidevops:GetAccountUsage"
      ],
      "Resource": "arn:aws:aidevops:*:${aws:PrincipalAccount}:agentspace/${aws:PrincipalTag/AgentSpaceId}",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "${aws:PrincipalAccount}"
        }
      }
    },
    {
      "Sid": "ObservabilityVerificationScoped",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:DescribeAlarms",
        "cloudwatch:GetMetricData",
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "xray:GetTraceSummaries",
        "xray:BatchGetTraces",
        "health:DescribeEvents",
        "health:DescribeEventDetails"
      ],
      "Resource": [
        "arn:aws:cloudwatch:*:${aws:PrincipalAccount}:alarm:*",
        "arn:aws:logs:*:${aws:PrincipalAccount}:log-group:*",
        "arn:aws:xray:*:${aws:PrincipalAccount}:trace/*",
        "arn:aws:health:*::event/*/*/*"
      ]
    },
    {
      "Sid": "ControlledRemediationViaApprovedSSMRunbooks",
      "Effect": "Allow",
      "Action": [
        "ssm:StartAutomationExecution",
        "ssm:GetAutomationExecution",
        "ssm:DescribeAutomationExecutions",
        "ssm:StopAutomationExecution"
      ],
      "Resource": [
        "arn:aws:ssm:*:${aws:PrincipalAccount}:automation-definition/Approved-Remediation-*:*",
        "arn:aws:ssm:*:${aws:PrincipalAccount}:automation-definition/AWS-Restart*:*",
        "arn:aws:ssm:*:${aws:PrincipalAccount}:automation-execution/*"
      ]
    },
    {
      "Sid": "ExplicitDenyDestructiveOperations",
      "Effect": "Deny",
      "Action": [
        "aidevops:DeleteAgentSpace",
        "aidevops:UpdateOperatorAppIdpConfig",
        "logs:DeleteLogGroup",
        "cloudwatch:PutMetricData",
        "ssm:SendCommand",
        "ec2:TerminateInstances",
        "s3:DeleteObject",
        "rds:DeleteDBInstance"
      ],
      "Resource": "*"
    }
  ]
}
