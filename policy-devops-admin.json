{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DevOpsAgentAdminScoped",
      "Effect": "Allow",
      "Action": [
        "aidevops:CreateAgentSpace",
        "aidevops:GetAgentSpace",
        "aidevops:UpdateAgentSpace",
        "aidevops:DeleteAgentSpace",
        "aidevops:EnableOperatorApp",
        "aidevops:DisableOperatorApp",
        "aidevops:UpdateOperatorAppIdpConfig",
        "aidevops:AssociateService",
        "aidevops:DisassociateService",
        "aidevops:CreatePrivateConnection",
        "aidevops:DeletePrivateConnection"
      ],
      "Resource": [
        "arn:aws:aidevops:*:${aws:PrincipalAccount}:agentspace/*",
        "arn:aws:aidevops:*:${aws:PrincipalAccount}:privateconnection/*"
      ]
    },
    {
      "Sid": "AllowServiceLinkedRolesForDevOpsAndResourceExplorer",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": [
        "arn:aws:iam::${aws:PrincipalAccount}:role/aws-service-role/aidevops.amazonaws.com/*",
        "arn:aws:iam::${aws:PrincipalAccount}:role/aws-service-role/resource-explorer-2.amazonaws.com/*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "aidevops.amazonaws.com",
            "resource-explorer-2.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "AllowSSOApplicationAssignment",
      "Effect": "Allow",
      "Action": [
        "sso:CreateApplicationAssignment",
        "sso:DeleteApplicationAssignment"
      ],
      "Resource": [
        "arn:aws:sso:::instance/*",
        "arn:aws:sso:::application/*"
      ]
    },
    {
      "Sid": "AllowPrivateLinkNetworkModificationScoped",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:CreateVpcEndpoint",
        "ec2:DeleteVpcEndpoints",
        "ec2:DeleteSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:*:${aws:PrincipalAccount}:vpc/*",
        "arn:aws:ec2:*:${aws:PrincipalAccount}:subnet/*",
        "arn:aws:ec2:*:${aws:PrincipalAccount}:security-group/*",
        "arn:aws:ec2:*:${aws:PrincipalAccount}:vpc-endpoint/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ManagedBy": "AIDevOps"
        }
      }
    },
    {
      "Sid": "AllowKmsKeyGrantsScopedToAccountKey",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:CreateGrant"
      ],
      "Resource": "arn:aws:kms:*:${aws:PrincipalAccount}:key/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Purpose": "AIDevOpsEncryption"
        }
      }
    },
    {
      "Sid": "ExplicitDenyComputeAndPrivilegeEscalation",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:TerminateInstances",
        "ec2:StopInstances",
        "kms:ScheduleKeyDeletion",
        "kms:DisableKey",
        "iam:CreateUser",
        "iam:CreateRole",
        "iam:AttachUserPolicy",
        "iam:AttachRolePolicy"
      ],
      "Resource": "*"
    }
  ]
}
